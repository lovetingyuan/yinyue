{
  "name": "inyue",
  "version": "1.0.0",
  "description": "An Awesome music app",
  "type": "module",
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "keywords": [
    "capacitor",
    "mobile"
  ],
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1 --port 5173 --strictPort --no-takeover",
    "dev:mobile": "nuxt dev --envName capacitor --host 127.0.0.1 --port 5174 --strictPort --no-takeover",
    "android": "concurrently --kill-others-on-fail -P -i --default-input-target 1 \"npm run dev:mobile\" \"node scripts/android-dev.mjs {@}\" --",
    "android:devices": "cap run android --list",
    "start": "npm run dev",
    "build": "nuxt build",
    "build:mobile": "nuxt generate --envName capacitor",
    "generate": "nuxt generate",
    "typecheck": "nuxt typecheck",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "preview": "npm run build && wrangler dev",
    "postinstall": "nuxt prepare",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types --include-main-module=false"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "latest",
    "@capacitor/core": "latest",
    "@capacitor/splash-screen": "latest",
    "@capgo/capacitor-social-login": "8.7.10",
    "@dwbn/capacitor-plugin-playlist": "8.4.3",
    "@lucide/vue": "^1.72.0",
    "@nuxtjs/better-auth": "0.3.16",
    "@pinia/colada": "^1.4.9",
    "@pinia/colada-nuxt": "^1.2.1",
    "@pinia/nuxt": "^1.0.3",
    "@tailwindcss/vite": "^4.3.5",
    "@vite-pwa/nuxt": "2.0.1",
    "@vue/devtools-api": "^8.2.1",
    "@vueuse/core": "^15.0.0",
    "better-auth": "1.7.22",
    "daisyui": "^5.8.0",
    "drizzle-orm": "0.45.2",
    "music-metadata": "12.5.0",
    "nitropack": "^2.13.6",
    "nuxt": "^4.6.4",
    "pinia": "^4.1.0",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "latest",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "nitro-cloudflare-dev": "^0.2.2",
    "oxlint": "^1.93.0",
    "typescript": "~6.0.3",
    "vite-plugin-dom-source": "^1.0.2",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.160.0"
  },
  "author": "",
  "license": "ISC"
}
